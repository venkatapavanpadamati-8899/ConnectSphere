# ConnectSphere - Environment Variables Template
# Copy this file to .env and fill in the actual values.
# NEVER commit the actual .env file to version control.

# ==========================================
# PUBLIC / BROWSER VARIABLES
# ==========================================
# These variables are safe to expose in the frontend/browser.
# They connect the client to the Supabase project.

# The URL of your Supabase project (e.g., https://your-project.supabase.co)
SUPABASE_URL=

# The public anon key for your Supabase project. Safe for browser usage.
SUPABASE_PUBLISHABLE_KEY=

# ==========================================
# SERVER / EDGE ONLY VARIABLES
# ==========================================
# NEVER expose these in the frontend or public browser code.
# These are strictly for secure Edge Functions or Backend scripts.

# The Supabase Service Role Key. Used to bypass RLS in secure functions.
SUPABASE_SERVICE_ROLE_KEY=

# Your Google Gemini API Key for AI features.
GEMINI_API_KEY=
